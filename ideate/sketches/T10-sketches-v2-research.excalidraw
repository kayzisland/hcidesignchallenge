l6", "type": "text", "x": 20, "y": -716, "width": 610.74, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 609005469, "version": 1, "versionNonce": 389426982, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "R-2  Timetable and slides only, never location. Place is asked, not sensed (Q-10)", "originalText": "R-2  Timetable and slides only, never location. Place is asked, not sensed (Q-10)", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "el7", "type": "text", "x": 20, "y": -692, "width": 580.5799999999999, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 179874664, "version": 1, "versionNonce": 1701494131, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "R-3/7  Fires at a breakpoint after a lecture, and says why now (LIT-4, AFF-H)", "originalText": "R-3/7  Fires at a breakpoint after a lecture, and says why now (LIT-4, AFF-H)", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "el8", "type": "text", "x": 20, "y": -668, "width": 746.4599999999999, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1945598123, "version": 1, "versionNonce": 676431976, "isDeleted": false, "boundElements": [], "updated": 1, "link"